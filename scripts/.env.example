# run_conditions.py 的环境配置模板。
# 复制本文件为 .env（开发）或 .env-prod（生产），填入真实值。
#   cp scripts/.env.example scripts/.env
# 运行时：
#   python3 run_conditions.py                          # 读 .env
#   python3 run_conditions.py --env-file scripts/.env-prod   # 读 .env-prod

# 必填 -----------------------------------------------------------------------
# cTrader CLI 鉴权 token
AUTH_TOKEN=your-ctrader-cli-auth-token
# cTrader 可执行文件路径
CTRADER_BIN=/Applications/cTrader.app/Contents/MacOS/cTrader.Mac
# 要回测的 .algo 包路径（注意：路径含空格时直接写，不要加引号）
ALGO_PATH=/path/to/PDHPDL Break and Reverse v1.algo
# cTrader ID（邮箱）与账户号
CTID=your@email.com
ACCOUNT=0000000

# 选填（不填则用脚本默认值 m1 / 10000）-----------------------------------------
# 回测数据模式：m1 / open / m1-csv
DATA_MODE=m1
# 回测初始资金
BALANCE=10000
