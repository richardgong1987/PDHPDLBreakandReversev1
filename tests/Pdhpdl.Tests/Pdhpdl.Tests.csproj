<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <!-- Unit tests for the strategy's pure (cAlgo-free) logic. The classes under test are
       LINKED in below (never a ProjectReference) so the tests never pull in the
       cTrader.Automate / cAlgo.API dependency. Only cAlgo-free files may be linked here.
       Test files mirror these folders: Risk/, Signals/, Orders/. -->
  <ItemGroup Label="Risk under test">
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Risk\PdhpdlRiskGuard.cs" Link="Risk\PdhpdlRiskGuard.cs" />
  </ItemGroup>

  <ItemGroup Label="Signals under test">
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Signals\HanJinSignals26.cs" Link="Signals\HanJinSignals26.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Biz\MainBiz.cs" Link="Biz\MainBiz.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Biz\ConsecutiveLossCounter.cs" Link="Biz\ConsecutiveLossCounter.cs" />
  </ItemGroup>

  <ItemGroup Label="OrderLogger under test">
    <Compile Include="..\..\PDHPDL Break and Reverse v1\OrderLogger\PdhpdlTradeCsvMigrator.cs" Link="OrderLogger\PdhpdlTradeCsvMigrator.cs" />
  </ItemGroup>

  <ItemGroup Label="Orders under test">
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Orders\PdhpdlOrderPlanner.cs" Link="Orders\PdhpdlOrderPlanner.cs" />
  </ItemGroup>

  <ItemGroup Label="Utils under test">
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Utils\RmaUtils.cs" Link="Utils\RmaUtils.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Utils\Utils.cs" Link="Utils\Utils.cs" />
  </ItemGroup>

  <!-- Data models the units above depend on. CAlgoSymbolModel is intentionally excluded:
       it is the only Models/ file that references cAlgo.API. -->
  <ItemGroup Label="Models under test">
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\PdhpdlRiskGuardConfigModel.cs" Link="Models\PdhpdlRiskGuardConfigModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\NewsBlackoutWindowModel.cs" Link="Models\NewsBlackoutWindowModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\PdhpdlTradeDirectionModel.cs" Link="Models\PdhpdlTradeDirectionModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\PdhpdlEntryModel.cs" Link="Models\PdhpdlEntryModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\StrategyModel.cs" Link="Models\StrategyModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\SignalFamilyModel.cs" Link="Models\SignalFamilyModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\PdhpdlSignalModel.cs" Link="Models\PdhpdlSignalModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\PdhpdlOrderPlanModel.cs" Link="Models\PdhpdlOrderPlanModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\IPdhpdlSymbolModel.cs" Link="Models\IPdhpdlSymbolModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\SignalSideModel.cs" Link="Models\SignalSideModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\CandleModel.cs" Link="Models\CandleModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\HanJinSignalOptionsModel.cs" Link="Models\HanJinSignalOptionsModel.cs" />
    <Compile Include="..\..\PDHPDL Break and Reverse v1\Models\HanJinSignalScanModel.cs" Link="Models\HanJinSignalScanModel.cs" />
